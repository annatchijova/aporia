{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aporia",
  "compatibility_date": "2025-09-25",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aporia",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ]
}
