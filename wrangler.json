{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aporia",
  "compatibility_date": "2025-09-25",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "ratelimits": [
    {
      "name": "ROOM_LOOKUP_LIMITER",
      "namespace_id": "89261001",
      "simple": { "limit": 30, "period": 10 }
    },
    {
      "name": "ROOM_CREATE_LIMITER",
      "namespace_id": "89261002",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "ROOM_JOIN_LIMITER",
      "namespace_id": "89261003",
      "simple": { "limit": 60, "period": 10 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aporia",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ]
}
