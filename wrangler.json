{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aporia",
  "compatibility_date": "2025-09-25",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "ratelimits": [
    {
      "name": "ROOM_LOOKUP_LIMITER",
      "namespace_id": "89261001",
      "simple": { "limit": 30, "period": 10 }
    },
    {
      "name": "ROOM_CREATE_LIMITER",
      "namespace_id": "89261002",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "ROOM_JOIN_LIMITER",
      "namespace_id": "89261003",
      "simple": { "limit": 60, "period": 10 }
    },
    {
      "name": "CREATOR_ACCESS_LIMITER",
      "namespace_id": "89261004",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aporia",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "aporia-staging",
      "workers_dev": false,
      "triggers": {
        "crons": []
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
      },
      "ratelimits": [
        {
          "name": "ROOM_LOOKUP_LIMITER",
          "namespace_id": "89262001",
          "simple": { "limit": 30, "period": 10 }
        },
        {
          "name": "ROOM_CREATE_LIMITER",
          "namespace_id": "89262002",
          "simple": { "limit": 3, "period": 60 }
        },
        {
          "name": "ROOM_JOIN_LIMITER",
          "namespace_id": "89262003",
          "simple": { "limit": 60, "period": 10 }
        },
        {
          "name": "CREATOR_ACCESS_LIMITER",
          "namespace_id": "89262004",
          "simple": { "limit": 5, "period": 60 }
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aporia-staging",
          "database_id": "1b2f22d9-7f22-4d20-82df-31f546a88f33",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
